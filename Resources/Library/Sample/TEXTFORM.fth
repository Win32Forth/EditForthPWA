\ TEXTFORM.fth — text formatter
\
\ Tom Zimmer wrote this to build the TCOM manual from a text file of
\ dot commands. The DOS program took the name on the command line and
\ wrote name.PRN. This copy asks for the file and writes name.prn.
\ It uses the console and files, so it runs on EditForth and EditForthPWA.
\
\ Load:
\   FROMLIB FLOAD Sample/TEXTFORM.fth
\   TEXTFORM
\
\ A blank line ends a paragraph. Lines that do not start with '.' are
\ text. See TEXTFORM-HELP for the dot commands. .lj .cj and .rj are
\ remembered; each line is still written from the left margin.
\
\ Public domain.

[DEFINED] ANEW [IF] ANEW TEXTFORM_MODULE [THEN]

ONLY FORTH DEFINITIONS
DECIMAL

80 CONSTANT TF-WIDE
8 CONSTANT TF-HMAX
160 CONSTANT TF-EMAX
96 CONSTANT TF-ESIZE

VARIABLE TF-LM   5 TF-LM !
VARIABLE TF-RM   76 TF-RM !
VARIABLE TF-LPP  66 TF-LPP !
VARIABLE TF-IND
VARIABLE TF-PAGE 1 TF-PAGE !
VARIABLE TF-ROW  1 TF-ROW !
VARIABLE TF-COL
VARIABLE TF-WRAP -1 TF-WRAP !
VARIABLE TF-JUST
VARIABLE TF-GUT
CREATE TF-SAVED 4 CELLS ALLOT
VARIABLE TF-HN
VARIABLE TF-FN
VARIABLE TF-H?
VARIABLE TF-F?
VARIABLE TF-OUT
VARIABLE TF-IN
VARIABLE TF-CH
VARIABLE TF-USECH
CREATE TF-NAME 300 ALLOT
VARIABLE TF-NLEN
CREATE TF-LINE 512 ALLOT
VARIABLE TF-LL
CREATE TF-OUTL 256 ALLOT
VARIABLE TF-OL
CREATE TF-HEAD TF-HMAX 128 * ALLOT
CREATE TF-FOOT TF-HMAX 128 * ALLOT
CREATE TF-TOC  TF-EMAX TF-ESIZE * ALLOT
CREATE TF-IDX  TF-EMAX TF-ESIZE * ALLOT
CREATE TF-TAB  TF-EMAX TF-ESIZE * ALLOT
CREATE TF-FIG  TF-EMAX TF-ESIZE * ALLOT
VARIABLE TF-TOCN
VARIABLE TF-IDXN
VARIABLE TF-TABN
VARIABLE TF-FIGN
CREATE TF-ONE 4 ALLOT

: TF-NUM ( c-addr u -- n flag )
  DUP 0= IF 2DROP 0 FALSE EXIT THEN
  0 SWAP 0 DO
    OVER I + C@
    DUP 48 58 WITHIN 0= IF DROP 2DROP DROP 0 FALSE UNLOOP EXIT THEN
    48 - SWAP 10 * +
  LOOP
  NIP TRUE ;

: TF-TRIM ( c-addr u -- c-addr2 u2 )
  BEGIN DUP 0> IF OVER C@ 32 = ELSE FALSE THEN WHILE
    SWAP 1+ SWAP 1-
  REPEAT ;

: TF-SPLIT ( c-addr u -- c-addr2 u2 c-addr1 u1 )
  BEGIN DUP 0> IF OVER C@ 32 = ELSE FALSE THEN WHILE
    SWAP 1+ SWAP 1-
  REPEAT
  OVER >R
  DUP >R
  BEGIN DUP 0> IF OVER C@ 32 <> ELSE FALSE THEN WHILE
    SWAP 1+ SWAP 1-
  REPEAT
  R> OVER - R> SWAP ;

: TF-2NUM ( c-addr u -- n1 n2 flag )
  TF-SPLIT 2SWAP 2>R
  TF-NUM
  2R> TF-TRIM TF-NUM
  ROT AND >R
  R> ;

: TF-UPPER ( c-addr u -- )
  0 ?DO
    DUP I + C@ DUP 97 123 WITHIN IF 32 - OVER I + C! ELSE DROP THEN
  LOOP DROP ;

: TF-EMIT ( c -- )
  TF-OL @ 250 > IF DROP EXIT THEN
  TF-OUTL TF-OL @ + C!
  1 TF-OL +!  1 TF-COL +! ;

: TF-SPACES ( n -- )
  0 MAX 0 DO 32 TF-EMIT LOOP ;

: TF-PUTS ( c-addr u -- )
  0 ?DO DUP I + C@ TF-EMIT LOOP DROP ;

: TF-WRITE ( -- )
  TF-OUTL TF-OL @ TF-OUT @ WRITE-LINE DROP
  0 TF-OL !  0 TF-COL !
  1 TF-ROW +! ;

: TF-SLOT ( base i -- a ) TF-ESIZE * + ;

\ Each header line is a counted string in 128 bytes.
: TF-HLINE ( base i -- a ) 128 * + ;

: TF-DUMPH ( base n -- )
  0 DO
    DUP I TF-HLINE COUNT TF-PUTS TF-WRITE
  LOOP DROP ;

: TF-FORM ( -- )
  12 TF-ONE C!
  TF-ONE 1 TF-OUT @ WRITE-FILE DROP
  1 TF-PAGE +!
  1 TF-ROW ! ;

: TF-BREAK ( -- )
  TF-FOOT TF-FN @ TF-DUMPH
  TF-FORM
  TF-HEAD TF-HN @ TF-DUMPH ;

: TF-ROOM ( -- )
  TF-ROW @  TF-LPP @ TF-FN @ -  >= IF TF-BREAK THEN ;

: TF-LEFT ( n -- )
  TF-PAGE @ 1 AND 0= IF TF-GUT @ + THEN
  TF-SPACES ;

: TF-FINISH ( -- )
  TF-COL @ IF TF-WRITE THEN ;

: TF-HPUT ( c-addr u dest -- )
  DUP >R
  OVER 120 MIN SWAP C!
  R> 1+ SWAP 120 MIN CMOVE ;

: TF-TEXT ( c-addr u -- )
  TF-H? @ IF
    TF-HN @ TF-HMAX >= IF 2DROP EXIT THEN
    TF-HEAD TF-HN @ TF-HLINE TF-HPUT
    1 TF-HN +! EXIT
  THEN
  TF-F? @ IF
    TF-FN @ TF-HMAX >= IF 2DROP EXIT THEN
    TF-FOOT TF-FN @ TF-HLINE TF-HPUT
    1 TF-FN +! EXIT
  THEN
  TF-WRAP @ 0= IF
    TF-ROOM TF-FINISH
    TF-LM @ TF-LEFT
    TF-PUTS TF-WRITE EXIT
  THEN
  BEGIN DUP 0> WHILE
    TF-SPLIT
    DUP TF-COL @ + 1+ TF-RM @ > TF-COL @ 0> AND IF
      TF-WRITE TF-ROOM
      TF-LM @ TF-LEFT
    THEN
    TF-COL @ 0= IF TF-LM @ TF-IND @ + TF-LEFT THEN
    TF-PUTS
    DUP IF 32 TF-EMIT THEN
  REPEAT
  2DROP ;

: TF-RULE ( c -- )
  TF-ROOM TF-FINISH
  TF-LM @ TF-LEFT
  TF-RM @ TF-LM @ - 0 MAX 0 DO DUP TF-EMIT LOOP DROP
  TF-WRITE ;

: TF-STORE ( c-addr u base var -- )
  DUP @ TF-EMAX >= IF 2DROP 2DROP EXIT THEN
  >R
  R@ @ TF-SLOT
  TF-PAGE @ OVER !
  1 CELLS + >R
  DUP 80 MIN R@ C!
  R> 1+ SWAP 80 MIN CMOVE
  R> 1 SWAP +! ;

: TF-LIST ( base var -- )
  DUP @ 0 DO
    TF-ROOM
    TF-LM @ TF-LEFT
    OVER I TF-SLOT
    DUP 1 CELLS + COUNT TF-PUTS
    32 TF-EMIT
    @ 0 <# #S #> TF-PUTS
    TF-WRITE
  LOOP 2DROP ;

: TF-CMD ( c-addr u -- )
  TF-SPLIT 2SWAP 2>R
  2DUP TF-UPPER
  2DUP S" .\" COMPARE 0= IF 2DROP 2R> 2DROP EXIT THEN
  2DUP S" .LJ" COMPARE 0= IF 2DROP 0 TF-JUST ! 2R> 2DROP EXIT THEN
  2DUP S" .CJ" COMPARE 0= IF 2DROP 1 TF-JUST ! 2R> 2DROP EXIT THEN
  2DUP S" .RJ" COMPARE 0= IF 2DROP 2 TF-JUST ! 2R> 2DROP EXIT THEN
  2DUP S" .WRAPON" COMPARE 0= IF 2DROP -1 TF-WRAP ! 2R> 2DROP EXIT THEN
  2DUP S" .WRAPOFF" COMPARE 0= IF 2DROP 0 TF-WRAP ! 2R> 2DROP EXIT THEN
  2DUP S" .HSTART" COMPARE 0= IF 2DROP -1 TF-H? ! 0 TF-F? ! 0 TF-HN ! 2R> 2DROP EXIT THEN
  2DUP S" .HEND" COMPARE 0= IF 2DROP 0 TF-H? ! TF-HEAD TF-HN @ TF-DUMPH 2R> 2DROP EXIT THEN
  2DUP S" .FSTART" COMPARE 0= IF 2DROP -1 TF-F? ! 0 TF-H? ! 0 TF-FN ! 2R> 2DROP EXIT THEN
  2DUP S" .FEND" COMPARE 0= IF 2DROP 0 TF-F? ! 2R> 2DROP EXIT THEN
  2DUP S" .HL" COMPARE 0= IF 2DROP 45 TF-RULE 2R> 2DROP EXIT THEN
  2DUP S" .HL2" COMPARE 0= IF 2DROP 61 TF-RULE 2R> 2DROP EXIT THEN
  2DUP S" .BXTOP" COMPARE 0= IF 2DROP 45 TF-RULE 2R> 2DROP EXIT THEN
  2DUP S" .BXBOTTOM" COMPARE 0= IF 2DROP 45 TF-RULE 2R> 2DROP EXIT THEN
  2DUP S" .PAGE" COMPARE 0= IF 2DROP TF-FINISH TF-BREAK 2R> 2DROP EXIT THEN
  2DUP S" .PAGETOP" COMPARE 0= IF 2DROP TF-ROW @ 1 > IF TF-FINISH TF-BREAK THEN 2R> 2DROP EXIT THEN
  2DUP S" .PG" COMPARE 0= IF 2DROP TF-PAGE @ 0 <# #S #> TF-TEXT 2R> 2DROP EXIT THEN
  2DUP S" .CONTENTS" COMPARE 0= IF 2DROP TF-TOC TF-TOCN TF-LIST 2R> 2DROP EXIT THEN
  2DUP S" .INDEX" COMPARE 0= IF 2DROP TF-IDX TF-IDXN TF-LIST 2R> 2DROP EXIT THEN
  2DUP S" .TABLE" COMPARE 0= IF 2DROP TF-TAB TF-TABN TF-LIST 2R> 2DROP EXIT THEN
  2DUP S" .FIGURES" COMPARE 0= IF 2DROP TF-FIG TF-FIGN TF-LIST 2R> 2DROP EXIT THEN
  2DUP S" .TITLE" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-TEXT TF-FINISH EXIT THEN
  2DUP S" .DATE" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-TEXT TF-FINISH EXIT THEN
  2DUP S" .C[" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-TOC TF-TOCN TF-STORE EXIT THEN
  2DUP S" .I[" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-IDX TF-IDXN TF-STORE EXIT THEN
  2DUP S" .T[" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-TAB TF-TABN TF-STORE EXIT THEN
  2DUP S" .F[" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-FIG TF-FIGN TF-STORE EXIT THEN
  2DUP S" .LM" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-NUM IF TF-LM ! ELSE DROP THEN EXIT THEN
  2DUP S" .RM" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-NUM IF TF-RM ! ELSE DROP THEN EXIT THEN
  2DUP S" .LPP" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-NUM IF 10 MAX TF-LPP ! ELSE DROP THEN EXIT THEN
  2DUP S" .INDENT" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-NUM IF TF-IND ! ELSE DROP THEN EXIT THEN
  2DUP S" .GUTTER" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-NUM IF TF-GUT ! ELSE DROP THEN EXIT THEN
  2DUP S" .SPG" COMPARE 0= IF 2DROP 2R> TF-TRIM TF-NUM IF TF-PAGE ! ELSE DROP THEN EXIT THEN
  2DUP S" .TOLINE" COMPARE 0= IF 2DROP 2R> TF-TRIM
    TF-NUM IF
      BEGIN TF-ROW @ OVER < WHILE TF-WRITE REPEAT DROP
    ELSE DROP THEN EXIT THEN
  2DUP S" .PAGE?" COMPARE 0= IF 2DROP 2R> TF-TRIM
    TF-NUM IF
      TF-LPP @ TF-FN @ - TF-ROW @ - OVER < IF TF-FINISH TF-BREAK THEN DROP
    ELSE DROP THEN EXIT THEN
  2DUP S" .PAGEEVEN" COMPARE 0= IF 2DROP
    TF-PAGE @ 1 AND 0= IF TF-FINISH TF-BREAK THEN 2R> 2DROP EXIT THEN
  2DUP S" .PAGEODD" COMPARE 0= IF 2DROP
    TF-PAGE @ 1 AND IF TF-FINISH TF-BREAK THEN 2R> 2DROP EXIT THEN
  2DUP S" .LM1" COMPARE 0= IF 2DROP 0 CELLS TF-SAVED + @ TF-LM ! 2R> 2DROP EXIT THEN
  2DUP S" .LM2" COMPARE 0= IF 2DROP 1 CELLS TF-SAVED + @ TF-LM ! 2R> 2DROP EXIT THEN
  2DUP S" .LM3" COMPARE 0= IF 2DROP 2 CELLS TF-SAVED + @ TF-LM ! 2R> 2DROP EXIT THEN
  2DUP S" .LM4" COMPARE 0= IF 2DROP 3 CELLS TF-SAVED + @ TF-LM ! 2R> 2DROP EXIT THEN
  2DUP S" .LM!" COMPARE 0= IF 2DROP 2R> TF-2NUM IF
      SWAP 1- DUP 0 4 WITHIN IF CELLS TF-SAVED + ! ELSE 2DROP THEN
    ELSE 2DROP THEN EXIT THEN
  2DUP S" .CHAPTER" COMPARE 0= IF
    2DROP 2R> TF-TRIM -TRAILING
    TF-USECH @ IF TF-CH @ CLOSE-FILE DROP THEN
    R/O BIN OPEN-FILE IF DROP CR ." Could not open the chapter." CR EXIT THEN
    TF-CH ! -1 TF-USECH ! EXIT
  THEN
  2DROP 2R> 2DROP
  CR ." Unrecognized dot command." CR ;

: TF-LINE! ( u -- )
  TF-LL !
  TF-LINE TF-LL @ + 0 SWAP C! ;

: TF-READ ( fileid -- flag )
  TF-LINE 500 ROT READ-LINE
  ?DUP IF DROP 2DROP FALSE EXIT THEN
  0= IF DROP FALSE EXIT THEN
  TF-LINE! TRUE ;

: TF-GET ( -- flag )
  TF-USECH @ IF
    TF-CH @ TF-READ IF TRUE EXIT THEN
    TF-CH @ CLOSE-FILE DROP
    0 TF-USECH !
  THEN
  TF-IN @ TF-READ ;

: TF-DO ( -- )
  TF-LINE TF-LL @ TF-TRIM
  DUP 0= IF 2DROP TF-FINISH TF-WRITE EXIT THEN
  OVER C@ 46 = IF TF-FINISH TF-CMD EXIT THEN
  TF-TEXT ;

: TF-INIT ( -- )
  5 TF-LM !  76 TF-RM !  66 TF-LPP !
  0 TF-IND !  1 TF-PAGE !  1 TF-ROW !  0 TF-COL !
  -1 TF-WRAP !  0 TF-JUST !  0 TF-GUT !
  0 TF-HN !  0 TF-FN !  0 TF-H? !  0 TF-F? !
  0 TF-TOCN !  0 TF-IDXN !  0 TF-TABN !  0 TF-FIGN !
  0 TF-OL !  0 TF-USECH !
  4 0 DO 0 I CELLS TF-SAVED + ! LOOP ;

: TF-STEM ( c-addr u -- c-addr u2 )
  DUP >R
  BEGIN DUP WHILE
    1- 2DUP + C@ 46 = IF R> DROP EXIT THEN
  REPEAT
  DROP R> ;

: TF-OUTNAME ( -- c-addr u )
  TF-NAME TF-NLEN @ TF-STEM
  DUP >R
  TF-NAME +
  S" .prn" ROT SWAP CMOVE
  R> 4 +
  DUP TF-NLEN ! ;

: TEXTFORM-HELP ( -- )
  CR ." TEXTFORM reads a text file and writes name.prn"
  CR ." .lm n .rm n .lpp n .indent n .gutter n .spg n"
  CR ." .lj .cj .rj .wrapon .wrapoff .page .pg .hl .hl2"
  CR ." .hstart .hend .fstart .fend .title .date .chapter file"
  CR ." .c[ .contents .i[ .index .t[ .table .f[ .figures"
  CR ." .lm! n value .lm1 .lm2 .lm3 .lm4 .toline n .page? n"
  CR ." .pageeven .pageodd .pagetop .bxtop .bxbottom .\ comment" CR ;

: TF-RUN ( -- )
  TF-NAME TF-NLEN @ R/O BIN OPEN-FILE IF
    DROP CR ." Could not open that file." CR EXIT
  THEN
  TF-IN !
  TF-OUTNAME W/O BIN CREATE-FILE IF
    DROP TF-IN @ CLOSE-FILE DROP
    CR ." Could not create the .prn file." CR EXIT
  THEN
  TF-OUT !
  TF-INIT
  CR ." Writing " TF-NAME TF-NLEN @ TYPE CR
  BEGIN TF-GET WHILE TF-DO REPEAT
  TF-FINISH
  TF-FOOT TF-FN @ TF-DUMPH
  TF-IN @ CLOSE-FILE DROP
  TF-USECH @ IF TF-CH @ CLOSE-FILE DROP THEN
  TF-OUT @ CLOSE-FILE DROP
  CR ." TEXTFORM finished." CR ;

: TEXTFORM ( -- )
  TEXTFORM-HELP
  CR ." File: "
  TF-NAME 240 ACCEPT DUP 0= IF DROP EXIT THEN
  TF-NLEN !
  TF-RUN ;

CR .( Run: TEXTFORM ) CR
