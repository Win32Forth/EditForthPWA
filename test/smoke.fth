\ EditForthPWA smoke. Prints ALL PASS, or FAIL <n> and ABORTs.
\ Test numbers count every CHECK, including the one that fails.

VARIABLE TN

: CHECK ( flag -- )
  TN @ 1+ TN !
  0= IF ." FAIL " TN @ . CR ABORT THEN ;

2 3 + 5 = CHECK

: SQUARE ( n -- n' ) DUP * ;
5 SQUARE 25 = CHECK
-4 SQUARE 16 = CHECK

: SIGN ( n -- n' ) DUP 0< IF NEGATE ELSE 1+ THEN ;
-3 SIGN 3 = CHECK
4 SIGN 5 = CHECK

: DOWN ( n -- 0 ) BEGIN 1- DUP 0= UNTIL ;
5 DOWN 0 = CHECK

: SUMTO ( n -- sum )
  0 SWAP BEGIN DUP 0> WHILE SWAP OVER + SWAP 1- REPEAT DROP ;
5 SUMTO 15 = CHECK

: SUM5 ( -- n ) 0 5 0 DO I + LOOP ;
SUM5 10 = CHECK

: ZTRIP ( -- n ) 0  0 0 ?DO 1+ LOOP ;
ZTRIP 0 = CHECK

: SUMSTEP ( -- n ) 0  10 0 DO I + 2 +LOOP ;
SUMSTEP 20 = CHECK

: LEAVES ( -- n ) 0  10 0 DO I 3 = IF LEAVE THEN I + LOOP ;
LEAVES 3 = CHECK

: NESTJ ( -- n ) 0  2 0 DO  3 0 DO J + LOOP LOOP ;
NESTJ 3 = CHECK

VARIABLE X
42 X !  X @ 42 = CHECK

99 CONSTANT C99
C99 99 = CHECK

: CONST ( n -- ) CREATE , DOES> @ ;
7 CONST SEVEN
SEVEN 7 = CHECK

: FACT ( n -- n' ) DUP 0= IF DROP 1 EXIT THEN DUP 1- RECURSE * ;
0 FACT 1 = CHECK
5 FACT 120 = CHECK

: LIT5 ( -- n ) [ 2 3 + ] LITERAL ;
LIT5 5 = CHECK

: TICKDUP ( -- xt ) ['] DUP ;
TICKDUP ' DUP = CHECK

CHAR A 65 = CHECK
: CA ( -- c ) [CHAR] Z ;
CA CHAR Z = CHECK

9 ' DUP EXECUTE 9 = CHECK DROP

1 2 dup + 4 = CHECK DROP

S"hi" NIP 2 = CHECK
S"hi" DROP C@ CHAR h = CHECK
: S"" S" " ;
S"" NIP 0= CHECK
: SM-PA1 [CHAR] $ PARSE ;
S" SM-PA1 3456" EVALUATE EVALUATE 3456 = CHECK
S" CHAR Z PARSE" EVALUATE NIP 0= CHECK
S" CHAR A PARSE A NIP" EVALUATE 0= CHECK
S" CHAR | PARSE 1234| EVALUATE" EVALUATE 1234 = CHECK
S" CHAR ^ PARSE  23 45 ^ NIP" EVALUATE 7 = CHECK
: SM-PN PARSE-NAME PARSE-NAME COMPARE 0= ;
S" SM-PN abcd abcd" EVALUATE CHECK
S" SM-PN abcde abcdf" EVALUATE 0= CHECK
: SM-SQ S\" abc" ;
SM-SQ S" abc" COMPARE 0= CHECK
: SM-SQE S\" \a\m\x41" ;
SM-SQE NIP 4 = CHECK
SM-SQE DROP C@ 7 = CHECK
SM-SQE DROP 1+ C@ 13 = CHECK
SM-SQE DROP 2 + C@ 10 = CHECK
SM-SQE DROP 3 + C@ CHAR A = CHECK
S\" " NIP 0= CHECK
S\" abcd" S\" 1234" S" 1234" COMPARE 0= CHECK
S" abcd" COMPARE 0= CHECK
S" AB" NIP 2 = CHECK
S" AB" DROP C@ CHAR A = CHECK
S"  AB" NIP 3 = CHECK
S"  AB" DROP C@ BL = CHECK
: SM-SLIT [ S" hi" ] SLITERAL ;
SM-SLIT S" hi" COMPARE 0= CHECK
S" hi" S" Up" REPLACES
S" %up%" PAD 8 SUBSTITUTE
1 = CHECK
S" hi" COMPARE 0= CHECK
S" abcd" PAD 3 SUBSTITUTE 0< CHECK 2DROP
S" 1 >IN +! x1" EVALUATE 1 = CHECK
S" 1 \S 2" EVALUATE 1 = CHECK
S" line-src.fth" INCLUDED 10 = CHECK 1 = CHECK

: HI ."hello" ;
HI CR

: DOTP .(dotp) ;
CR

HEX FF DECIMAL 255 = CHECK
HEX #99 DECIMAL 99 = CHECK
%1010 10 = CHECK
'A' 65 = CHECK

-7 3 / -2 = CHECK
-7 3 MOD -1 = CHECK
-7 3 /MOD -2 = CHECK -1 = CHECK
10 0 3 FM/MOD 3 = CHECK 1 = CHECK
-10 -1 3 FM/MOD -4 = CHECK 2 = CHECK
-10 -1 3 SM/REM -3 = CHECK -1 = CHECK
10 0 -3 FM/MOD -4 = CHECK -2 = CHECK
0 0 0 FM/MOD -1 = CHECK 0 = CHECK
FILE-ECHO @ 0= CHECK
-2147483648 -1 / -2147483648 = CHECK
-2147483648 -1 MOD 0 = CHECK

5 2/ 2 = CHECK
-5 2/ -3 = CHECK
-1 1 RSHIFT 2147483647 = CHECK
1 31 LSHIFT -2147483648 = CHECK
1 32 LSHIFT 0 = CHECK
1 -1 LSHIFT 0 = CHECK

TRUE -1 = CHECK
FALSE 0 = CHECK
BL 32 = CHECK
CELL 4 = CHECK

1 2 3 4 2SWAP
2 = CHECK 1 = CHECK 4 = CHECK 3 = CHECK

1 2 3 4 2OVER
2 = CHECK 1 = CHECK 4 = CHECK 3 = CHECK 2 = CHECK 1 = CHECK

10 20 30 1 ROLL 20 = CHECK 30 = CHECK 10 = CHECK
10 20 30 2 ROLL 10 = CHECK 30 = CHECK 20 = CHECK
10 20 30 0 ROLL 30 = CHECK 20 = CHECK 10 = CHECK

2 9 MIN 2 = CHECK
2 9 MAX 9 = CHECK
-3 -1 MIN -3 = CHECK
-3 -1 MAX -1 = CHECK

' DUP NAME>STRING NIP 3 = CHECK
' DUP NAME>STRING DROP C@ CHAR D = CHECK
' DUP VIEW-FILE# 2 = CHECK
' DUP VIEW-LINE 0<> CHECK
' DUP VIEW-FILE# VIEW-PATH S" Resources/System/Sources/ef32.c" COMPARE 0= CHECK
' CELL+ VIEW-FILE# 1 = CHECK
' DUP >BODY ' DUP - 8 = CHECK
' DUP DUP >LINK - 12 = CHECK
' DUP >FLAGS ' DUP SWAP - 8 = CHECK
' IF >FLAGS CELL+ @ 1 31 LSHIFT AND 0<> CHECK
' DUP >FLAGS CELL+ @ 1 31 LSHIFT AND 0= CHECK
' HERE >HELP C@ 0> CHECK
9 CONSTANT NINE
NINE 9 = CHECK
FORTH-WORDLIST FORTH-WORDLIST 2 SET-ORDER
VOCABULARY DEMO
DEMO
CELL 4 = CHECK
ONLY
CELL 4 = CHECK
ONLY ALSO FORTH
GET-ORDER 2 = CHECK 2DROP
-1 SET-ORDER
GET-ORDER 1 = CHECK FORTH-WORDLIST = CHECK
ONLY

BL WORD DUP FIND NIP -1 = CHECK
BL WORD ; FIND NIP 1 = CHECK

0 SPACES
VIEW CELL+
VIEW DUP
VIEW NO-SUCH-VIEWWORD

C" HELLO" COUNT NIP 5 = CHECK
: CQ C" world" COUNT NIP ;
CQ 5 = CHECK
123 S>D 0 = CHECK 123 = CHECK
-5 S>D -1 = CHECK -5 = CHECK
123. 0 = CHECK 123 = CHECK
-5. -1 = CHECK -5 = CHECK
: DL 123. ; DL 0 = CHECK 123 = CHECK
100 0 2CONSTANT SM-DC
SM-DC 0 = CHECK 100 = CHECK
HERE 5 , HERE 6 , CONSTANT SM-H2 CONSTANT SM-H1
SM-H1 2@ 5 = CHECK 6 = CHECK
: SM-GS1 S" SOURCE" 2DUP EVALUATE >R SWAP >R = R> R> = ;
SM-GS1 CHECK CHECK
50 0 2VALUE SM-DV
200 0 TO SM-DV
SM-DV 0 = CHECK 200 = CHECK
: SETDV 7 0 TO SM-DV ; SETDV
SM-DV 0 = CHECK 7 = CHECK
5 S>D 3 S>D D- 0 = CHECK 2 = CHECK
0 0 D0= CHECK
1 0 D0= 0= CHECK
1 0 D2* 0 = CHECK 2 = CHECK
-1 -1 D2/ -1 = CHECK -1 = CHECK
1 0 2 0 D< CHECK
1 0 1 0 D= CHECK
5 0 D>S 5 = CHECK
9 0 2 0 DMAX 0 = CHECK 9 = CHECK
9 0 2 0 DMIN 0 = CHECK 2 = CHECK
1 0 0 0 DU< 0= CHECK
0 0 1 0 DU< CHECK
5 S>D 3 M+ 0 = CHECK 8 = CHECK
1 2 3 4 5 6 2ROT
2 = CHECK 1 = CHECK 6 = CHECK 5 = CHECK 4 = CHECK 3 = CHECK

:NONAME 6 7 + ; EXECUTE 13 = CHECK
0 0 S" 12X" >NUMBER 1 = CHECK DROP 0 = CHECK 12 = CHECK
S" abcdef" S" cd" SEARCH 0= 0= CHECK 4 = CHECK DROP
S" ab" S" " SEARCH 0= 0= CHECK 2 = CHECK DROP
SOURCE-ID 1 = CHECK
S" SOURCE-ID" EVALUATE -1 = CHECK
BLK @ 0= CHECK
7 BLK !
S" BLK @" EVALUATE 0= CHECK
BLK @ 7 = CHECK
0 BLK !
S" CORE" ENVIRONMENT? NIP 0= 0= CHECK
S" FLOORED" ENVIRONMENT? DROP 0= CHECK
S" DOUBLE" ENVIRONMENT? NIP 0= 0= CHECK
S" /COUNTED-STRING" ENVIRONMENT? DROP 255 = CHECK
S" WORDLISTS" ENVIRONMENT? DROP 8 = CHECK
S" #LOCALS" ENVIRONMENT? DROP 32 = CHECK
S" XCHAR-ENCODING" ENVIRONMENT? DROP S" UTF-8" COMPARE 0= CHECK
' XEMIT 0= 0= CHECK
S" NO-SUCH-ENV" ENVIRONMENT? 0= CHECK
: SM-?REPEAT 0 CS-PICK POSTPONE UNTIL ; IMMEDIATE
VARIABLE SM-PT4
: SM-PT5
   SM-PT4 !
   BEGIN
      -1 SM-PT4 +!
      SM-PT4 @ 4 > 0= SM-?REPEAT
      111
      SM-PT4 @ 3 > 0= SM-?REPEAT
      222
      SM-PT4 @ 2 > 0= SM-?REPEAT
      333
      SM-PT4 @ 1 =
   UNTIL ;
6 SM-PT5
333 = CHECK 222 = CHECK 111 = CHECK
333 = CHECK 222 = CHECK 111 = CHECK
222 = CHECK 111 = CHECK 111 = CHECK
: SM-?DONE POSTPONE IF 1 CS-ROLL ; IMMEDIATE
: SM-PT6 >R BEGIN R@ SM-?DONE R@ R> 1- >R REPEAT R> DROP ;
5 SM-PT6
1 = CHECK 2 = CHECK 3 = CHECK 4 = CHECK 5 = CHECK
: SM-MIX 2 CS-ROLL ; IMMEDIATE
: SM-PT7
   IF 1111 ROT ROT
      IF 2222 SWAP
         IF 3333 SM-MIX THEN
         4444
      THEN
      5555
   THEN
   6666 ;
-1 -1 -1 SM-PT7
6666 = CHECK 5555 = CHECK 4444 = CHECK 3333 = CHECK 2222 = CHECK 1111 = CHECK
