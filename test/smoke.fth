VARIABLE FA
S" smoke-fa.txt" W/O CREATE-FILE 0= CHECK FA !
S" hello" FA @ WRITE-LINE 0= CHECK
FA @ FILE-POSITION 0= CHECK DROP DROP
0 0 FA @ REPOSITION-FILE 0= CHECK
PAD 80 FA @ READ-LINE 0= CHECK SWAP 5 = AND CHECK
PAD C@ CHAR h = CHECK
20 0 FA @ RESIZE-FILE 0= CHECK
FA @ FILE-SIZE 0= CHECK 0= CHECK 20 = CHECK
FA @ CLOSE-FILE 0= CHECK
S" smoke-fa.txt" R/O OPEN-FILE 0= CHECK FA !
PAD 80 FA @ READ-LINE 0= CHECK SWAP 5 = AND CHECK
FA @ CLOSE-FILE DROP
S" smoke-fa.txt" FILE-STATUS NIP 0= CHECK
S" smoke-fa.txt" S" smoke-fa2.txt" RENAME-FILE 0= CHECK
S" smoke-fa.txt" FILE-STATUS NIP 0<> CHECK
S" smoke-fa2.txt" DELETE-FILE 0= CHECK
S" smoke-fa2.txt" FILE-STATUS NIP 0<> CHECK

TIME&DATE
DUP 1970 > CHECK DROP
DUP 1 13 WITHIN CHECK DROP
DUP 1 32 WITHIN CHECK DROP
DUP 0 24 WITHIN CHECK DROP
DUP 0 60 WITHIN CHECK DROP
DUP 0 61 WITHIN CHECK DROP

DEPTH 0 = CHECK

." ALL PASS" CR
