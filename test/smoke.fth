: SM-PT8
   >R AHEAD 111 BEGIN 222 SM-1CS THEN 333 R> 1- >R R@ 0< UNTIL R> DROP ;
1 SM-PT8
333 = CHECK 222 = CHECK 333 = CHECK
: SM-SYN1 4321 ;
SYNONYM SM-NEWSYN SM-SYN1 99
SM-NEWSYN 4321 = CHECK
99 = CHECK
